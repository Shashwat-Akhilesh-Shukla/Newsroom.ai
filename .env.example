# Environment variables for AI Newsroom
# Copy this file to .env and fill in your actual values

# LLM API Keys
# Perplexity API — get yours at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# External Service API Keys
# Reddit and DuckDuckGo are used for trend discovery — no API keys required!

# GitHub API (for repository research)
GITHUB_TOKEN=your_github_token_here

# Database Configuration (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsroom

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Agent Configuration
SCOUT_CONFIDENCE_THRESHOLD=0.7
MAX_RESEARCH_SOURCES=10
MAX_REVISION_LOOPS=3
SKEPTIC_QUALITY_THRESHOLD=0.8

# LLM Configuration
# Provider: perplexity (OpenAI-compatible API)
# Available Perplexity models: sonar, sonar-pro, sonar-reasoning
LLM_PROVIDER=perplexity
DEFAULT_MODEL=sonar
SCOUT_MODEL=sonar
RESEARCHER_MODEL=sonar
SKEPTIC_MODEL=sonar
WRITER_MODEL=sonar
EDITOR_MODEL=sonar
PUBLISHER_MODEL=sonar

# Publishing Configuration
MEDIUM_API_KEY=your_medium_api_key_here
MEDIUM_USER_ID=your_medium_user_id_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/newsroom.log

# Development
DEBUG=False
