# Environment variables for AI Newsroom
# Copy this file to .env and fill in your actual values

# LLM API Keys
# Google Gemini API — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# External Service API Keys
# Reddit and DuckDuckGo are used for trend discovery — no API keys required!

# GitHub API (for repository research)
GITHUB_TOKEN=your_github_token_here

# Database Configuration (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsroom

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Agent Configuration
SCOUT_CONFIDENCE_THRESHOLD=0.7
MAX_RESEARCH_SOURCES=10
MAX_REVISION_LOOPS=3
SKEPTIC_QUALITY_THRESHOLD=0.8

# LLM Configuration
# Provider: gemini (Google Gemini API)
# Available Gemini models: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-pro, gemini-1.5-flash
LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash
SCOUT_MODEL=gemini-2.0-flash
RESEARCHER_MODEL=gemini-2.0-flash
SKEPTIC_MODEL=gemini-2.0-flash
WRITER_MODEL=gemini-2.0-flash
EDITOR_MODEL=gemini-2.0-flash
PUBLISHER_MODEL=gemini-2.0-flash

# Publishing Configuration
MEDIUM_API_KEY=your_medium_api_key_here
MEDIUM_USER_ID=your_medium_user_id_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/newsroom.log

# Development
DEBUG=False
