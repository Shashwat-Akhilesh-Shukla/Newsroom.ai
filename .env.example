# Environment variables for AI Newsroom
# Copy this file to .env and fill in your actual values

# ===========================================================================
# LangSmith Observability (optional but strongly recommended for production)
# Get your API key at: https://smith.langchain.com
# ===========================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=newsroom-dev          # project name shown in LangSmith UI
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default, do not change


# Google Gemini API — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# External Service API Keys
# Reddit and DuckDuckGo are used for trend discovery — no API keys required!

# GitHub API (for repository research)
GITHUB_TOKEN=your_github_token_here

# Database Configuration (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsroom

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Agent Configuration
SCOUT_CONFIDENCE_THRESHOLD=0.7
MAX_RESEARCH_SOURCES=10
MAX_REVISION_LOOPS=3
SKEPTIC_QUALITY_THRESHOLD=0.8

# LLM Configuration
# Provider: gemini (Google Gemini API)
# Available Gemini models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash
SCOUT_MODEL=gemini-2.5-flash
RESEARCHER_MODEL=gemini-2.5-flash
SKEPTIC_MODEL=gemini-2.5-flash
WRITER_MODEL=gemini-2.5-flash
EDITOR_MODEL=gemini-2.5-flash
PUBLISHER_MODEL=gemini-2.5-flash

# Publishing Configuration (Reddit via PRAW)
# Create a "script" app at https://www.reddit.com/prefs/apps to get client_id & client_secret
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_SUBREDDIT=artificial
REDDIT_USER_AGENT=AI_Newsroom/1.0 by your_reddit_username
REDDIT_POST_FLAIR=  # optional flair text

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/newsroom.log

# Development
DEBUG=False
